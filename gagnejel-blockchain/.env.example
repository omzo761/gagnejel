# GagneJèl Smart Contract Environment Variables

# ============================================
# WALLET PRIVATE KEY (CRITICAL - KEEP SECRET!)
# ============================================
# Votre clé privée pour déployer les contracts
# JAMAIS commiter cette clé sur Git !
PRIVATE_KEY=your_wallet_private_key_here

# ============================================
# BASESCAN API KEY (pour vérifier les contracts)
# ============================================
# Créer un compte sur https://basescan.org/
# Puis obtenir une API key gratuite
BASESCAN_API_KEY=your_basescan_api_key_here

# ============================================
# CONTRACT ADDRESSES (après déploiement)
# ============================================
# Adresse du contract sur Base Sepolia (testnet)
ESCROW_CONTRACT_ADDRESS_SEPOLIA=

# Adresse du contract sur Base Mainnet (production)
ESCROW_CONTRACT_ADDRESS_MAINNET=

# ============================================
# USDC ADDRESSES (déjà configurées)
# ============================================
# Base Mainnet USDC
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Base Sepolia USDC (testnet)
USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ============================================
# BACKEND CONFIGURATION
# ============================================
# Adresse du portefeuille backend (pour appeler les fonctions owner)
BACKEND_WALLET_ADDRESS=

# ============================================
# NOTES IMPORTANTES
# ============================================
# 1. Renommer ce fichier en .env après l'avoir rempli
# 2. Ajouter .env au .gitignore
# 3. JAMAIS partager votre PRIVATE_KEY
# 4. Pour le testnet, obtenir de l'ETH gratuit sur:
#    https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
