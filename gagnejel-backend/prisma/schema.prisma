// ============================================
// GAGNEJÈL - DATABASE SCHEMA
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id            String    @id @default(uuid())
  walletAddress String    @unique
  username      String?   @unique
  email         String?   @unique
  
  // Profile
  avatar        String?
  bio           String?
  country       String?
  
  // Stats
  totalBets     Int       @default(0)
  totalWins     Int       @default(0)
  totalLosses   Int       @default(0)
  winRate       Float     @default(0)
  
  // Blockchain
  balance       Decimal   @default(0) @db.Decimal(18, 6)
  
  // Relations
  bets          Bet[]
  groupMembers  GroupMember[]
  messages      Message[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  
  @@index([walletAddress])
  @@index([username])
}

// ============================================
// MATCH MODEL
// ============================================
model Match {
  id            String    @id @default(uuid())
  
  // Match Info
  sport         String    // "football", "basketball", "wrestling"
  league        String
  homeTeam      String
  awayTeam      String
  
  // Match Details
  startTime     DateTime
  venue         String?
  
  // Status
  status        String    @default("upcoming") // "upcoming", "live", "finished", "cancelled"
  
  // Results
  homeScore     Int?
  awayScore     Int?
  winner        String?   // "home", "away", "draw"
  
  // External API
  apiId         String?   @unique
  apiProvider   String?
  
  // Relations
  bets          Bet[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([status])
  @@index([sport])
  @@index([startTime])
}

// ============================================
// BET MODEL
// ============================================
model Bet {
  id            String    @id @default(uuid())
  
  // Bet Info
  userId        String
  matchId       String
  groupId       String?
  
  // Bet Details
  type          String    // "DUO", "TRIO", "QUATRO", "5"
  prediction    String    // "home", "away", "draw"
  amount        Decimal   @db.Decimal(18, 6)
  
  // Odds
  odds          Float
  potentialWin  Decimal   @db.Decimal(18, 6)
  
  // Status
  status        String    @default("pending") // "pending", "won", "lost", "cancelled", "refunded"
  
  // Results
  isWinner      Boolean?
  payout        Decimal?  @db.Decimal(18, 6)
  
  // Blockchain
  txHash        String?   @unique
  blockNumber   Int?
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  group         Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  settledAt     DateTime?
  
  @@index([userId])
  @@index([matchId])
  @@index([groupId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// GROUP MODEL
// ============================================
model Group {
  id            String    @id @default(uuid())
  
  // Group Info
  name          String
  description   String?
  avatar        String?
  
  // Settings
  isPrivate     Boolean   @default(false)
  inviteCode    String?   @unique
  maxMembers    Int       @default(50)
  
  // Stats
  totalMembers  Int       @default(0)
  totalBets     Int       @default(0)
  totalVolume   Decimal   @default(0) @db.Decimal(18, 6)
  
  // Relations
  members       GroupMember[]
  bets          Bet[]
  messages      Message[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([inviteCode])
}

// ============================================
// GROUP MEMBER MODEL
// ============================================
model GroupMember {
  id            String    @id @default(uuid())
  
  userId        String
  groupId       String
  
  // Role
  role          String    @default("member") // "admin", "member"
  
  // Stats
  totalBets     Int       @default(0)
  totalWins     Int       @default(0)
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  // Timestamps
  joinedAt      DateTime  @default(now())
  
  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

// ============================================
// MESSAGE MODEL (Chat)
// ============================================
model Message {
  id            String    @id @default(uuid())
  
  userId        String
  groupId       String
  
  // Message
  content       String
  type          String    @default("text") // "text", "bet", "result"
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  
  @@index([groupId, createdAt])
  @@index([userId])
}