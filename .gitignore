# .gitignore - Fichiers à ignorer

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3
prisma/migrations/
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Build outputs
dist/
build/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.dockerignore

# SSL certificates (development)
ssl/*.key
ssl/*.crt
ssl/*.pem

# Backups
backups/
*.backup
*.sql.gz
*.tar.gz
*.encrypted

# Temporary files
tmp/
temp/
.tmp/

# Monitoring data
monitoring/data/
prometheus_data/
grafana_data/

# Cache
.cache/
.parcel-cache/

# Testing
cypress/videos/
cypress/screenshots/
.nyc_output/

# Secrets
secrets.json
private.key
*.secret

# Local development
docker-compose.override.yml
.env.override
backend/prisma/backup_*.sql